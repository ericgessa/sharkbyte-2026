# Copy to mobile/.env (git-ignored). Expo inlines EXPO_PUBLIC_* values into the app bundle,
# so anything here is readable by anyone with the app: NEVER put the Supabase secret key here.

# Backend API. Get the right value from the backend dev (see docs/frontend-integration.md):
#   physical phone on the same Wi-Fi : http://<backend-dev-LAN-IP>:8000
#   Android emulator                 : http://10.0.2.2:8000
#   iOS simulator / Expo web         : http://localhost:8000
#   remote teammate / different net  : the https tunnel URL the backend dev shares
EXPO_PUBLIC_API_URL=http://192.168.0.0:8000

# Supabase project (public values).
EXPO_PUBLIC_SUPABASE_URL=https://djphcmzoldlmzoosgcej.supabase.co
# Publishable key (sb_publishable_...): Dashboard > Project Settings > API Keys. Safe for the client.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
