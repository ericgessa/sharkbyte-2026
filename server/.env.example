# Copy to server/.env (git-ignored) and fill in. Never commit server/.env.
# Where to find these: see SUPABASE_SETUP.md.

# Dashboard > Settings > API (Project URL), e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Dashboard > Settings > API Keys > "Secret keys" (sb_secret_...).
# BACKEND ONLY. It bypasses Row Level Security. Never put it in the mobile/web app.
# (Projects that still use legacy keys can use the service_role key here instead.)
SUPABASE_SECRET_KEY=your-secret-key

# Safe for client apps (sb_publishable_...). Not used by the server yet; this is the
# only Supabase key the frontend may ever hold.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
