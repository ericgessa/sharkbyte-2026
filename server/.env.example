# Copy to server/.env (git-ignored) and fill in. Never commit server/.env.
# Where to find these: see SUPABASE_SETUP.md.

# Dashboard > Settings > API (Project URL), e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Dashboard > Settings > API Keys > "Secret keys" (sb_secret_...).
# BACKEND ONLY. It bypasses Row Level Security. Never put it in the mobile/web app.
# (Projects that still use legacy keys can use the service_role key here instead.)
SUPABASE_SECRET_KEY=your-secret-key

# Safe for client apps (sb_publishable_...). Not used by the server yet; this is the
# only Supabase key the frontend may ever hold.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Tiger Data (TimescaleDB): sensor time-series. See TIGERDATA_SETUP.md ---
# OPTIONAL. Without it the app works normally; sensor readings are simply not stored.
# Tiger Console > your service > connection details: the service URL, like
#   postgres://tsdbadmin:PASSWORD@xxxxxxxx.xxxxxx.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# BACKEND ONLY: it contains the database password. Never put it in the mobile app.
TIGERDATA_URL=
# If your URL has no password (the console often shows it without one), keep the password here instead.
# Special characters are fine here; they are encoded for you.
# TIGERDATA_PASSWORD=

# --- AI coach (LLM) ---
# OPTIONAL. Off by default: the rule-based coach works on its own. When enabled, an LLM words the feedback the
# rules already decided on (and writes the end-of-workout recap); any failure falls back to the rules.
# Pick ONE provider. Gemini is the team's plan:
# COACH_LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key                # BACKEND ONLY. Never in the mobile app.
# (or) COACH_LLM_PROVIDER=anthropic
# (or) ANTHROPIC_API_KEY=your-anthropic-key     # BACKEND ONLY.
# optional:
# COACH_LLM_MODEL=gemini-3.5-flash-lite         # default per provider (claude-opus-5-5 for anthropic)
# COACH_LLM_TIMEOUT_S=6                         # how long a cue may wait before the rule message is used
